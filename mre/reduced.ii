namespace detail{
struct tag_marker{};
template<typename T>
struct is_tag
{
  static const bool value=(is_base_and_derived<tag_marker,T>::value);
};
}
template<typename... Ts>
struct tag:private detail::tag_marker
{
  static_assert(detail::no_duplicate_tags<tag>::value, "detail::no_duplicate_tags<tag>::value");
};
