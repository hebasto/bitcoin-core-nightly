template<class V, class... T> constexpr std::size_t cx_count()
{
    constexpr bool a[] = { false, std::is_same<T, V>::value... };
    std::size_t r = 0;
    for( std::size_t i = 0; i < sizeof...(T); ++i )
    {
        r += a[ i+1 ];
    }
    return r;
}
