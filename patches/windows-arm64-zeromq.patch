depends: Fix the zeromq build for aarch64-w64-mingw32 with a GCC-compatible compiler

libzmq 4.3.5 has no rdtsc() branch for a GCC-compatible compiler
targeting Windows on AArch64 and falls through to the clock_gettime()
code, which uses nsecs_per_usec, a constant not declared on Windows:

  src/clock.cpp:251:48: error: use of undeclared identifier 'nsecs_per_usec'

Carry upstream libzmq commit b71434140e8ed40b1840a5704370bfc8dfdbf627
("Fix reading cycle count on non-msvc win-on-aarch64"), which is not in
any 4.3.x release, as a depends patch.

Applied by .github/workflows/windows-llvm-arm64.yml; not submitted
upstream because Bitcoin Core neither builds nor tests this platform.

diff --git a/depends/packages/zeromq.mk b/depends/packages/zeromq.mk
index ab10e6c..423d193 100644
--- a/depends/packages/zeromq.mk
+++ b/depends/packages/zeromq.mk
@@ -12,6 +12,7 @@ $(package)_patches += cmake_minimum.patch
 $(package)_patches += cacheline_undefined.patch
 $(package)_patches += no_librt.patch
 $(package)_patches += add_new_include.patch
+$(package)_patches += windows_arm64_rdtsc.patch
 
 define $(package)_set_vars
   $(package)_config_opts := -DCMAKE_BUILD_TYPE=None -DWITH_DOCS=OFF -DWITH_LIBSODIUM=OFF
@@ -30,7 +31,8 @@ define $(package)_preprocess_cmds
   patch -p1 < $($(package)_patch_dir)/openbsd_kqueue_headers.patch && \
   patch -p1 < $($(package)_patch_dir)/cmake_minimum.patch && \
   patch -p1 < $($(package)_patch_dir)/no_librt.patch && \
-  patch -p1 < $($(package)_patch_dir)/add_new_include.patch
+  patch -p1 < $($(package)_patch_dir)/add_new_include.patch && \
+  patch -p1 < $($(package)_patch_dir)/windows_arm64_rdtsc.patch
 endef
 
 define $(package)_config_cmds
diff --git a/depends/patches/zeromq/windows_arm64_rdtsc.patch b/depends/patches/zeromq/windows_arm64_rdtsc.patch
new file mode 100644
index 0000000..1423d7d
--- /dev/null
+++ b/depends/patches/zeromq/windows_arm64_rdtsc.patch
@@ -0,0 +1,20 @@
+Fix reading the cycle counter when targeting Windows on AArch64 with
+a GCC-compatible compiler, such as LLVM MinGW. Without this, rdtsc()
+falls through to the clock_gettime() branch, which references
+nsecs_per_usec, a constant that is not declared on Windows.
+
+Upstream commit b71434140e8ed40b1840a5704370bfc8dfdbf627.
+
+--- a/src/clock.cpp
++++ b/src/clock.cpp
+@@ -223,6 +223,10 @@ uint64_t zmq::clock_t::rdtsc ()
+                                  ((13 & 15) << 3) | // crm
+                                  ((0 & 7) << 0));   // op2
+     return _ReadStatusReg (pmccntr_el0);
++#elif (defined(_WIN32) && defined(__GNUC__) && defined(__aarch64__))
++    uint64_t val;
++    __asm__ volatile("mrs %0, pmccntr_el0" : "=r"(val));
++    return val;
+ #elif (defined __GNUC__ && (defined __i386__ || defined __x86_64__))
+     uint32_t low, high;
+     __asm__ volatile("rdtsc" : "=a"(low), "=d"(high));
